<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Ranks_RevealAllRanks</AssemblyName>
    <RootNamespace>Ranks.RevealAllRanks</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/Ranks_RevealAllRanks</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SwiftlyS2.CS2" Version="*-*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- A committed copy of the DLL rather than a ProjectReference to the Ranks checkout: this is
         a standalone repository, so CI clones it alone and a cross-repo path would not resolve.
         Refresh it from Ranks.Contract/build/net10.0/ when the contract gains members.

         Private=false is load-bearing, not tidiness: the host loads the single copy that ships in
         Ranks' resources/exports, and a second one beside this plugin would give IRanksApi two
         Type identities, so TryGetSharedInterface silently stops matching (FR-API-00).

         The reference is optional in a stronger sense than other modules' — this plugin is fully
         functional with Ranks absent, and uses the contract only for the rank-change re-broadcast. -->
    <Reference Include="Ranks.Contract">
      <HintPath>lib/Ranks.Contract.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/templates/**/*;resources/translations/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <UsingTask TaskName="ExtractPluginVersion"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <PluginVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          var content = System.IO.File.ReadAllText(FilePath);
          var m = System.Text.RegularExpressions.Regex.Match(content, "Version\\s*=\\s*\"([^\"]+)\"");
          PluginVersion = m.Success ? m.Groups[1].Value : "";
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="CreateZip" AfterTargets="Publish">
    <ExtractPluginVersion FilePath="$(MSBuildThisFileDirectory)src\Ranks_RevealAllRanks.cs">
      <Output TaskParameter="PluginVersion" PropertyName="_PluginVersion" />
    </ExtractPluginVersion>
    <Error Condition="'$(_PluginVersion)' == ''"
           Text="CreateZip: failed to extract PluginMetadata.Version from src\Ranks_RevealAllRanks.cs." />

    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName)-v$(_PluginVersion).zip" Overwrite="true" />
  </Target>

</Project>
